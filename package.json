{
  "name": "baituljannah-root",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "start:frontend": "npm run start --workspace=baituljannah-frontend",
    "start:backend": "npm run start --workspace=baituljannah-backend",
    "dev:frontend": "npm run dev --workspace=baituljannah-frontend",
    "dev:backend": "npm run dev --workspace=baituljannah-backend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
